# Smart Solar Mini Cold Storage - Environment Configuration

# Application settings
APP_NAME="Smart Solar Mini Cold Storage"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Security & JWT
SECRET_KEY="sih-smart-storage-ner-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 days for farmer friendly UX

# Database connection
# Default: SQLite for immediate local execution without external setup
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/smart_storage
DATABASE_URL="sqlite:///./smart_storage.db"

# Hardware Simulation Mode
SIMULATION_MODE=True
SIMULATION_TICK_SECONDS=4
DEFAULT_STORAGE_UNIT="NER-CS-001"

# CORS configuration
ALLOWED_ORIGINS=["*"]
