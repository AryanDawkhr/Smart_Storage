# Smart Solar Mini Cold Storage - Environment Configuration

# Application settings
APP_NAME="Smart Solar Mini Cold Storage"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Security & JWT
SECRET_KEY="sih-smart-storage-ner-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 days for farmer friendly UX

# Database connection
DATABASE_URL="mysql+pymysql://smart_storage_app:choose-a-strong-password@localhost:3306/smart_storage"

# Hardware Simulation Mode
SIMULATION_MODE=True
SIMULATION_TICK_SECONDS=4
DEFAULT_STORAGE_UNIT="NER-CS-001"

# CORS configuration
ALLOWED_ORIGINS=["*"]
